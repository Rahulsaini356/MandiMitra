# ==============================================================
# WayEzee MandiMitra — Environment Variables Configuration
# ==============================================================

# 1. Google Gemini API Key for Conversational Assistant & Voice
# Get key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Government of India Data.gov.in AGMARKNET Mandi Price API Key
# Get key at: https://data.gov.in/
VITE_DATAGOV_API_KEY=your_datagov_api_key_here

# 3. Geoapify Driving Routing & Highway Distance API Key
# Get key at: https://www.geoapify.com/
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here
VITE_ROUTING_API_KEY=your_geoapify_api_key_here
